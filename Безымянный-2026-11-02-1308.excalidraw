    {
      "id": "el17",
      "type": "text",
      "x": 60,
      "y": 698,
      "width": 623.4375,
      "height": 542.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1964216888,
      "version": 4,
      "versionNonce": 165179084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793690368816,
      "link": null,
      "locked": false,
      "text": "CREATE DATABASE IF NOT EXISTS shop_db CHARACTER SET utf8mb4;\nUSE shop_db;\n\nDROP TABLE IF EXISTS products;\nDROP TABLE IF EXISTS categories;\n\nCREATE TABLE categories (\n  id INT AUTO_INCREMENT PRIMARY KEY,\n  name VARCHAR(50) NOT NULL\n);\n\nCREATE TABLE products (\n  id INT AUTO_INCREMENT PRIMARY KEY,\n  title VARCHAR(100) NOT NULL,\n  price DECIMAL(10,2) NOT NULL CHECK (price >= 0),\n  stock INT NOT NULL DEFAULT 0,\n  category_id INT NOT NULL,\n  FOREIGN KEY (category_id) REFERENCES categories(id)\n);\n\nINSERT INTO categories (name) VALUES ('Компьютеры'), ('Аксессуары');\n\nINSERT INTO products (title, price, stock, category_id) VALUES\n('Ноутбук 15\"', 85000, 10, 1),\n('Монитор 27\"', 28000, 5, 1),\n('Клавиатура', 6500, 20, 2),\n('Мышь беспроводная', 2500, 30, 2);\n\nDROP USER IF EXISTS 'shop_app'@'localhost';\nCREATE USER 'shop_app'@'localhost' IDENTIFIED BY 'ShopApp#2024';\nGRANT SELECT, INSERT, UPDATE, DELETE ON shop_db.* TO 'shop_app'@'localhost';",
      "originalText": "CREATE DATABASE IF NOT EXISTS shop_db CHARACTER SET utf8mb4;\nUSE shop_db;\n\nDROP TABLE IF EXISTS products;\nDROP TABLE IF EXISTS categories;\n\nCREATE TABLE categories (\n  id INT AUTO_INCREMENT PRIMARY KEY,\n  name VARCHAR(50) NOT NULL\n);\n\nCREATE TABLE products (\n  id INT AUTO_INCREMENT PRIMARY KEY,\n  title VARCHAR(100) NOT NULL,\n  price DECIMAL(10,2) NOT NULL CHECK (price >= 0),\n  stock INT NOT NULL DEFAULT 0,\n  category_id INT NOT NULL,\n  FOREIGN KEY (category_id) REFERENCES categories(id)\n);\n\nINSERT INTO categories (name) VALUES ('Компьютеры'), ('Аксессуары');\n\nINSERT INTO products (title, price, stock, category_id) VALUES\n('Ноутбук 15\"', 85000, 10, 1),\n('Монитор 27\"', 28000, 5, 1),\n('Клавиатура', 6500, 20, 2),\n('Мышь беспроводная', 2500, 30, 2);\n\nDROP USER IF EXISTS 'shop_app'@'localhost';\nCREATE USER 'shop_app'@'localhost' IDENTIFIED BY 'ShopApp#2024';\nGRANT SELECT, INSERT, UPDATE, DELETE ON shop_db.* TO 'shop_app'@'localhost';",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
